# Copy to /var/electrum/electrumx.conf, mode 0600. Never commit real credentials.
COIN=FixedCoin
NET=mainnet
DB_DIRECTORY=/var/electrum/db
# Match your node's configured port (Core default: 24767).
DAEMON_URL=http://CHANGE_ME:CHANGE_ME@127.0.0.1:24761/
# Start on loopback; configure public TCP/TLS/WSS and certificates deliberately.
SERVICES=tcp://127.0.0.1:50001,rpc://127.0.0.1:8000
REPORT_SERVICES=
PEER_DISCOVERY=off
PEER_ANNOUNCE=
CACHE_MB=256
MAX_SESSIONS=1000
BANNER_FILE=/var/electrum/banner.txt
LOG_LEVEL=INFO
